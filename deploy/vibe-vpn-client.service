[Unit]
Description=not-vpn client
After=network-online.target
Wants=network-online.target
# Restart the whole unit if the service fails after boot.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=@BIN@ client --config @CONFIG@
# Always keep the tunnel up; back off between attempts (RetrySec is handled by
# the client's own reconnect loop, so keep the systemd restart short).
Restart=on-failure
RestartSec=5
# Stop restarting forever if it fails 5 times in 5 minutes (above).
StartLimitIntervalSec=300
StartLimitBurst=5
# TUN creation and routing require privileges; nothing else needs to be a root
# user, so drop capabilities to the minimum after startup.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only

# Journald logging (default) is already structured; add a stable identifier.
SyslogIdentifier=vibe-vpn-client

[Install]
WantedBy=multi-user.target
