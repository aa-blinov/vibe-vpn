# Example client configuration. Copy to client.yaml and fill in keys from
# `vibe-vpn keygen`.
client:
  server: SERVER_PUBLIC_IP:443
  # transport: udp   # udp (default) | tls | raw
  private_key: CHANGE_ME_CLIENT_PRIVATE_KEY
  # private_key_encrypted: <blob from `vibe-vpn keygen -encrypt`>  # passphrase-protected
  server_public_key: CHANGE_ME_SERVER_PUBLIC_KEY
  mtu: 1280
  # Optional: request a specific address inside the server subnet.
  # client_ip: 10.77.0.2
  # Configure the client TUN address and routes automatically (default route
  # through the tunnel, with the VPN server's own address pinned to the real
  # network so the tunnel does not capture itself).
  setup_routing: true
  keepalive_interval: 10
  session_timeout: 300
  rekey_after_packets: 268435456
  rekey_after_seconds: 180
  stats_interval: 15
  # Optional obfs4-style TCP fallback (must match server `raw.listen`). If the
  # primary transport (TLS/UDP) fails, the client transparently falls back to
  # this one on each reconnect.
  # raw_server: SERVER_PUBLIC_IP:4444
  # Prometheus metrics endpoint (loopback; empty disables).
  # metrics: 127.0.0.1:9090
  # Wire-level traffic shaping: uniform packet sizes, timing jitter and decoy
  # frames while idle. This is what makes the flow harder to fingerprint by
  # passive traffic classification.
  shaping:
    padding: web      # none | pad | bucket | random | web
                      # web: packet sizes sampled from a realistic HTTPS
                      # distribution (best camouflage against passive DPI)
    # pad_to: 1280    # all session frames padded to this wire size (pad)
    # bucket: 128     # wire size rounded up to a multiple (bucket)
    # rand_max: 128   # random padding up to this many bytes (random)
    decoy_interval_s: 2   # cover traffic, fired at randomized intervals
    jitter_max_ms: 20
  # Optional TLS transport. The server address must point at the TLS port.
  # tls:
  #   server_name: vpn.example.com   # SNI + certificate name
  #   ca: /etc/vibe-vpn/server.crt     # certificate generated by `vibe-vpn certgen`
  #   fingerprint: chrome            # chrome | firefox | legacy (default: chrome)
  #   # insecure: true               # only if you skip certificate pinning
  # Optional DPI desync of the tunnel's own TCP flow (zapret's nfqws), so the
  # TLS connection to the server is harder to recognize. Requires root and the
  # nfqws binary built from https://github.com/bol-van/zapret. The tunnel must
  # run over TLS (TCP). The client creates the nftables queue rule and starts
  # nfqws itself, and removes both on exit.
  # desync:
  #   enabled: true
  #   nfqws: /usr/local/bin/nfqws
  #   dpi_desync: split2          # split2 | fake | fake,multisplit | ...
  #   split_pos: "2"              # for split modes ("" disables)
  #   fooling: badseq             # for fake modes ("" disables)
  # Writes a pcap of the plaintext tunnel traffic to /tmp/vibe-vpn-client.pcap.
  # debug: /tmp/vibe-vpn-client
